{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run",
    "scope",
    "sources",
    "searches",
    "candidates",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "skill-audit.context/v1"
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer",
        "model",
        "effort",
        "condition"
      ],
      "properties": {
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "effort": {
          "type": [
            "string",
            "null"
          ]
        },
        "condition": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "candidate_ids"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "candidate_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "searches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scope",
          "outcome",
          "reason",
          "locator",
          "observed_at"
        ],
        "properties": {
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "type": "string",
            "enum": [
              "found",
              "no_match",
              "unavailable",
              "not_searched"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "observed_at": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "locator",
        "observed_at",
        "sha256",
        "parent_id",
        "coverage"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "inventory",
            "file",
            "native",
            "memory",
            "conversation",
            "record"
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "observed_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "parent_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "coverage": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "locator"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definition",
        "window",
        "coverage"
      ],
      "properties": {
        "definition": {
          "type": "string",
          "minLength": 1
        },
        "window": {
          "type": "string",
          "minLength": 1
        },
        "coverage": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "area",
        "basis",
        "statement",
        "evidence",
        "uncertainty",
        "metric"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "area": {
          "type": "string",
          "enum": [
            "purpose",
            "provenance",
            "resources",
            "consumers",
            "usage",
            "history"
          ]
        },
        "basis": {
          "type": "string",
          "enum": [
            "observed",
            "inferred"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "uncertainty": {
          "type": [
            "string",
            "null"
          ]
        },
        "metric": {
          "anyOf": [
            {
              "$ref": "#/$defs/metric"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "area": {
                "const": "usage"
              }
            }
          },
          "then": {
            "properties": {
              "metric": {
                "$ref": "#/$defs/metric"
              }
            }
          }
        }
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "locations",
        "status",
        "coverage_reason",
        "claims",
        "questions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "locations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "complete",
            "partial",
            "blocked"
          ]
        },
        "coverage_reason": {
          "type": "string",
          "minLength": 1
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "area",
              "question",
              "next_evidence"
            ],
            "properties": {
              "area": {
                "type": "string",
                "enum": [
                  "purpose",
                  "provenance",
                  "resources",
                  "consumers",
                  "usage",
                  "history"
                ]
              },
              "question": {
                "type": "string",
                "minLength": 1
              },
              "next_evidence": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
